{
    "manifest_version": 3,
    "name": "Teams Member Adder",
    "version": "1.1.0",
    "description": "Batch add members to Microsoft Teams from a masterlist file. Upload your class roster and automatically add all students to your team.",
    "author": "Daniel",
    "action": {
        "default_icon": {
            "48": "icons/icon-48.png",
            "96": "icons/icon-96.png"
        },
        "default_title": "Teams Member Adder"
    },
    "icons": {
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png"
    },
    "permissions": [
        "activeTab",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "*://teams.microsoft.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://teams.microsoft.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "popup.html"
            ],
            "matches": [
                "*://teams.microsoft.com/*"
            ]
        }
    ]
}
